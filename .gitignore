# Secrets. Nothing in this list may ever be committed.
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json
gcp-credentials*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
# Setuptools metadata, regenerated by `pip install -e .`. It records the
# absolute paths of whoever last installed the package, so committing it means
# committing one developer's machine layout.
*.egg-info/

# Node
node_modules/
dist/
.vite/
*.local

# Word and Office temporary files
~$*.docx
~$*.xlsx
~$*.pptx

# OneDrive and OS noise
desktop.ini
Thumbs.db
.DS_Store

# Application build output
/frontend/build/
/backend/.mypy_cache/
