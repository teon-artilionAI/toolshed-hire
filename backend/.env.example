# Toolshed Hire backend configuration.
#
# Copy to .env for local development. The .env file is git ignored and must
# never be committed. Every value below is a placeholder, not a secret.

# development, test, staging or production. Outside development and test the
# process refuses to start on the placeholder secrets below.
ENVIRONMENT=development

# PostgreSQL DSN. postgres:// and postgresql:// are rewritten to the psycopg
# driver automatically. In staging and production this must be the POOLED
# endpoint, which carries "-pooler" in the host name. A direct endpoint behind
# Cloud Run exhausts its connection allowance.
DATABASE_URL=postgresql+psycopg://toolshed:toolshed@localhost:5432/toolshed

# HMAC signing key for access tokens. Minimum 32 characters outside
# development. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=development-only-insecure-secret-do-not-deploy

# HS256, HS384 or HS512.
JWT_ALGORITHM=HS256

# Access token lifetime in minutes, between 1 and 60.
ACCESS_TOKEN_MINUTES=15

# Comma separated browser origins allowed to call the API directly. In
# production the browser talks to Vercel, which rewrites /api/* to Cloud Run
# server side, so there is no cross origin request to permit. This list exists
# for the Vite dev server.
CORS_ORIGINS=http://localhost:5173

# Password given to every account created by seed.py. Required outside
# development, where the script refuses to seed a known password.
SEED_PASSWORD=toolshed-dev-password
