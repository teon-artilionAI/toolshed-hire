# Toolshed Hire backend configuration.
#
# Copy to .env for local development. The .env file is git ignored and must
# never be committed. Every value below is a placeholder, not a secret.

# development, test, staging or production. Outside development and test the
# process refuses to start on the placeholder secrets below, sends
# Strict-Transport-Security, marks the refresh cookie Secure, and stops serving
# /docs, /redoc and /openapi.json. Staging is treated exactly like production.
ENVIRONMENT=development

# PostgreSQL DSN. postgres:// and postgresql:// are rewritten to the psycopg
# driver automatically. In staging and production this must be the POOLED
# endpoint, which carries "-pooler" in the host name. A direct endpoint behind
# Cloud Run exhausts its connection allowance.
DATABASE_URL=postgresql+psycopg://toolshed:toolshed@localhost:5432/toolshed

# HMAC signing key for access tokens. Minimum 32 characters outside
# development. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The key identifier in the token header and the salt of the sign in throttle
# are both derived from this value, so neither has a setting of its own.
JWT_SECRET=development-only-insecure-secret-do-not-deploy

# HS256, HS384 or HS512.
JWT_ALGORITHM=HS256

# Access token lifetime in minutes, between 1 and 60. The design document
# sets 15. The refresh token lifetimes are not settings. A session ends 14 days
# after the sign in and 7 days after it was last used.
ACCESS_TOKEN_MINUTES=15

# How many sign in attempts one fifteen minute window allows. The first is
# counted for each email address being signed in to, and the second for each
# client address the attempts come from. One more attempt than the limit is
# answered 429 with Retry-After. The defaults are 10 and 30, and neither can be
# set below 1. In development and test any value from 1 up is accepted, which
# lets a browser test run sign the same account in many times. In staging and
# production a limit can only be lowered. A value above its default stops the
# process from starting. The window itself is not a setting.
LOGIN_ATTEMPTS_PER_EMAIL=10
LOGIN_ATTEMPTS_PER_ADDRESS=30

# The limits of the account routes, which follow the same rules as the two
# above. A registration and a reset request that name one email address are
# counted in a window of an hour, and so is an account asking for its
# verification link again. Everything counted for a client address uses a
# window of fifteen minutes. The windows are not settings.
REGISTER_ATTEMPTS_PER_EMAIL=5
REGISTER_ATTEMPTS_PER_ADDRESS=10
VERIFICATION_ATTEMPTS_PER_ADDRESS=20
VERIFICATION_RESENDS_PER_ACCOUNT=5
RESET_REQUESTS_PER_EMAIL=5
RESET_REQUESTS_PER_ADDRESS=10
RESET_COMPLETIONS_PER_ADDRESS=10

# Comma separated browser origins allowed to call the API directly. In
# production the browser talks to Vercel, which rewrites /api/* to Cloud Run
# server side, so there is no cross origin request to permit. Locally this
# list is the Vite dev server.
#
# The same list is what POST /api/auth/refresh and POST /api/auth/logout
# compare the Origin header with. A browser sends Origin on a same origin POST,
# so in staging and production this must hold the public address of the site
# itself, for example https://www.example.co.za. Without it every refresh from
# a browser is answered 403.
CORS_ORIGINS=http://localhost:5173

# Where the links in the verification and reset messages point, with no path
# and no trailing slash. Left unset it is the one origin in CORS_ORIGINS, which
# in a deployment is the site itself. In staging and production it has to be
# an https address that is not this machine, or the process refuses to start.
# FRONTEND_ORIGIN=http://localhost:5173

# The Cloud Run revision name, reported by GET /api/health as "revision". Cloud
# Run sets it on every instance and nobody sets it by hand. It is left unset
# here on purpose, and the health endpoint then reports "local".
# K_REVISION=

# The Resend API key for outgoing email. Left unset, blank or as the literal
# not-configured-yet, email is switched off. The service still starts, logs one
# warning, and records every booking confirmation as FAILED with the reason.
# RESEND_API_KEY=not-configured-yet

# The From header of every email. The default below is the sender Resend
# accepts without a verified domain.
EMAIL_FROM="Toolshed Hire <onboarding@resend.dev>"

# Optional. When set, this is the only address the service will send email to,
# compared without regard to case. A message for anyone else is refused on the
# server before the provider is called. It is never redirected. This is how a
# demonstration environment runs without a verified sending domain.
# EMAIL_ALLOWED_RECIPIENT=

# Test only. Starts the clock the API uses at this time of day in Cape Town on
# today's real date, and lets it run on in real time from there, so the browser
# tests can book for today and check out whatever time they run. It is honoured
# only when ENVIRONMENT=test. Every other environment refuses to start with it
# set. Leave it unset everywhere else.
# TEST_BUSINESS_TIME=10:00

# Password given to every account created by seed.py. Required outside
# development and test, where the script refuses to seed a known password.
SEED_PASSWORD=toolshed-dev-password

# Optional. When set, the customer accounts created by seed.py get this
# password and the staff and admin accounts keep SEED_PASSWORD. Left unset
# locally, so every seeded account shares the one password above.
# SEED_CUSTOMER_PASSWORD=

# Read only by scripts/provision_roles.py, which the owner of the database runs
# once before the first migration. The first is the owner's connection string.
# The other two are the passwords given to the toolshed_app and toolshed_migrate
# roles, sixteen characters or more. They are left unset here on purpose. Set
# them in the shell for the one command that needs them and nowhere else.
# DATABASE_OWNER_URL=
# APP_ROLE_PASSWORD=
# MIGRATE_ROLE_PASSWORD=
