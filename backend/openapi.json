{
  "openapi": "3.1.0",
  "info": {
    "title": "Toolshed Hire API",
    "description": "Rental system for Toolshed Hire. Availability is the allocation of specific tagged assets over half open date periods, enforced by a PostgreSQL GiST exclusion constraint.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Report dependency health",
        "description": "Report database reachability and the presence of the btree_gist extension.\n\nReturns 200 when everything the application needs is present, and 503 when\nit is not, so an uptime check does not have to parse the body to decide\nwhether the service is usable.",
        "operationId": "read_health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Exchange credentials for an access token and a refresh cookie",
        "description": "Verify credentials, open a session and issue both tokens.\n\nRaises:\n    InvalidCredentials: If the sign in was refused. Mapped to HTTP 401.\n    TooManyAttempts: If the caller is throttled. Mapped to HTTP 429.",
        "operationId": "post_login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "The sign in was refused. The body is the same whatever the reason."
          },
          "429": {
            "description": "Too many attempts. `Retry-After` carries the wait in seconds."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Exchange the refresh cookie for a new access token and a new cookie",
        "description": "Rotate the refresh token and issue a new access token.\n\nRaises:\n    SessionExpired: If the cookie is missing or no longer good. Mapped to\n        HTTP 401, with the cookie cleared.",
        "operationId": "post_refresh_api_auth_refresh_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "The refresh cookie is missing, unknown, expired, revoked or already used."
          },
          "403": {
            "description": "The request named an origin that is not one of the configured ones."
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Revoke the session of the refresh cookie and clear the cookie",
        "description": "Revoke the session the cookie names, if any, and clear the cookie.\n\nThe answer is 204 whether or not there was a cookie and whether or not it\nnamed a live session.",
        "operationId": "post_logout_api_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "403": {
            "description": "The request named an origin that is not one of the configured ones."
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "Return the signed in account",
        "description": "Return the account behind the presented access token.\n\nArgs:\n    user: The active account, resolved by the layered auth dependencies.\n    session: The request scoped session, used to resolve the branch code.\n\nReturns:\n    The account, in the shape every session response carries it in.",
        "operationId": "read_me_api_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/allocations": {
      "post": {
        "tags": [
          "allocations"
        ],
        "summary": "Hold specific assets for a hire period",
        "description": "Create a held reservation and allocate specific assets to it.\n\nArgs:\n    payload: The product model, branch, half open period and quantity.\n    user: The active account making the request.\n    use_case: The reservation use case. It owns the commit.\n\nReturns:\n    The committed reservation with the tagged units held.\n\nRaises:\n    ValidationFailure: If the period is not a valid hire period.\n    AuthorisationFailure: If a customer tries to book on someone else's behalf.\n    BranchScopeError: If counter staff try to book at a branch that is not\n        their own. Mapped to HTTP 403.\n    AllocationConflictError: If no free unit exists. Mapped to HTTP 409.",
        "operationId": "post_allocation_api_allocations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AllocationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AllocationResponse"
                }
              }
            }
          },
          "409": {
            "description": "No free unit exists for the requested period."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/branches": {
      "get": {
        "tags": [
          "branches"
        ],
        "summary": "List the trading branches",
        "description": "Return every active branch, ordered by name.",
        "operationId": "list_branches_api_branches_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BranchListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalogue/categories": {
      "get": {
        "tags": [
          "catalogue"
        ],
        "summary": "List the catalogue categories",
        "description": "Return every active category, each parent followed by its children.\n\n`modelCount` counts the published models of a category, and for a parent\nit includes the models of its children.",
        "operationId": "list_categories_api_catalogue_categories_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalogue/models": {
      "get": {
        "tags": [
          "catalogue"
        ],
        "summary": "List the published models",
        "description": "Return one page of the published models that match the query.\n\nRaises:\n    ValidationFailure: If the category is unknown. Mapped to HTTP 422.",
        "operationId": "list_models_api_catalogue_models_get",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A category slug. A parent category includes its children.",
              "title": "Category"
            },
            "description": "A category slug. A parent category includes its children."
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ],
              "description": "Free text matched against name, manufacturer and model number.",
              "title": "Q"
            },
            "description": "Free text matched against name, manufacturer and model number."
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ModelSortParameter",
              "description": "The order of the list.",
              "default": "name"
            },
            "description": "The order of the list."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10000,
              "minimum": 1,
              "description": "The page, counted from 1.",
              "default": 1,
              "title": "Page"
            },
            "description": "The page, counted from 1."
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "How many models a page holds.",
              "default": 24,
              "title": "Pagesize"
            },
            "description": "How many models a page holds."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelPageResponse"
                }
              }
            }
          },
          "422": {
            "description": "A query parameter was refused. `errors.fields` names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalogue/models/{slug}": {
      "get": {
        "tags": [
          "catalogue"
        ],
        "summary": "Return one published model",
        "description": "Return the published model with this slug.\n\nRaises:\n    NotFound: If no published model carries the slug. Mapped to HTTP 404.",
        "operationId": "read_model_api_catalogue_models__slug__get",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "No published model carries this slug.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalogue/availability": {
      "get": {
        "tags": [
          "availability"
        ],
        "summary": "Search availability across the catalogue",
        "description": "Return one page of models with an answer from every active branch.\n\nRaises:\n    ValidationFailure: If the period, the category or the branch is\n        refused. Mapped to HTTP 422, naming the parameter.",
        "operationId": "search_availability_api_catalogue_availability_get",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "The first day of the hire.",
              "title": "From"
            },
            "description": "The first day of the hire."
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "The day the equipment comes back. It is free again that day.",
              "title": "To"
            },
            "description": "The day the equipment comes back. It is free again that day."
          },
          {
            "name": "branch",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A branch code. Only models free at this branch are listed.",
              "title": "Branch"
            },
            "description": "A branch code. Only models free at this branch are listed."
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A category slug. A parent category includes its children.",
              "title": "Category"
            },
            "description": "A category slug. A parent category includes its children."
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ],
              "description": "Free text matched against name, manufacturer and model number.",
              "title": "Q"
            },
            "description": "Free text matched against name, manufacturer and model number."
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ModelSortParameter",
              "description": "The order of the list.",
              "default": "name"
            },
            "description": "The order of the list."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10000,
              "minimum": 1,
              "description": "The page, counted from 1.",
              "default": 1,
              "title": "Page"
            },
            "description": "The page, counted from 1."
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "How many models a page holds.",
              "default": 24,
              "title": "Pagesize"
            },
            "description": "How many models a page holds."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityPageResponse"
                }
              }
            }
          },
          "422": {
            "description": "A query parameter was refused. `errors.fields` names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalogue/models/{slug}/availability": {
      "get": {
        "tags": [
          "availability"
        ],
        "summary": "Return where one model is free",
        "description": "Return the branches where at least `quantity` units are free for the period.\n\nRaises:\n    NotFound: If no published model carries the slug. Mapped to HTTP 404.\n    ValidationFailure: If the period or the quantity is refused, or the\n        period is outside the hire limits of the model. Mapped to HTTP 422.",
        "operationId": "read_model_availability_api_catalogue_models__slug__availability_get",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "The first day of the hire.",
              "title": "From"
            },
            "description": "The first day of the hire."
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "The day the equipment comes back. It is free again that day.",
              "title": "To"
            },
            "description": "The day the equipment comes back. It is free again that day."
          },
          {
            "name": "quantity",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10,
              "minimum": 1,
              "description": "How many units are wanted at one branch.",
              "default": 1,
              "title": "Quantity"
            },
            "description": "How many units are wanted at one branch."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelAvailabilityResponse"
                }
              }
            }
          },
          "404": {
            "description": "No published model carries this slug.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "422": {
            "description": "A query parameter was refused. `errors.fields` names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AllocatedAssetResponse": {
        "properties": {
          "allocationId": {
            "type": "string",
            "format": "uuid",
            "title": "Allocationid"
          },
          "assetId": {
            "type": "string",
            "format": "uuid",
            "title": "Assetid"
          },
          "assetTag": {
            "type": "string",
            "title": "Assettag"
          }
        },
        "type": "object",
        "required": [
          "allocationId",
          "assetId",
          "assetTag"
        ],
        "title": "AllocatedAssetResponse",
        "description": "One physical unit held by the booking."
      },
      "AllocationRequest": {
        "properties": {
          "productModelId": {
            "type": "string",
            "format": "uuid",
            "title": "Productmodelid"
          },
          "branchId": {
            "type": "string",
            "format": "uuid",
            "title": "Branchid"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "title": "Startdate"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "title": "Enddate"
          },
          "quantity": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Quantity",
            "default": 1
          },
          "customerUserId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Customeruserid"
          }
        },
        "type": "object",
        "required": [
          "productModelId",
          "branchId",
          "startDate",
          "endDate"
        ],
        "title": "AllocationRequest",
        "description": "A booking request posted by the client.\n\nThe period is half open. `endDate` is the day the unit comes back and is\nnot charged, which is the same rule the exclusion constraint enforces."
      },
      "AllocationResponse": {
        "properties": {
          "reservationId": {
            "type": "string",
            "format": "uuid",
            "title": "Reservationid"
          },
          "reference": {
            "type": "string",
            "title": "Reference"
          },
          "reservationLineId": {
            "type": "string",
            "format": "uuid",
            "title": "Reservationlineid"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "title": "Startdate"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "title": "Enddate"
          },
          "allocated": {
            "items": {
              "$ref": "#/components/schemas/AllocatedAssetResponse"
            },
            "type": "array",
            "title": "Allocated"
          }
        },
        "type": "object",
        "required": [
          "reservationId",
          "reference",
          "reservationLineId",
          "status",
          "startDate",
          "endDate",
          "allocated"
        ],
        "title": "AllocationResponse",
        "description": "The committed booking returned to the client."
      },
      "AvailabilityPageResponse": {
        "properties": {
          "from": {
            "type": "string",
            "format": "date",
            "title": "From"
          },
          "to": {
            "type": "string",
            "format": "date",
            "title": "To"
          },
          "hireDays": {
            "type": "integer",
            "title": "Hiredays"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ModelAvailabilityRowResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "pageSize": {
            "type": "integer",
            "title": "Pagesize"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "from",
          "to",
          "hireDays",
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "title": "AvailabilityPageResponse",
        "description": "One page of an availability search.\n\n`to` is the day the equipment comes back. It is exclusive, so a unit is\nfree again on that day."
      },
      "BranchAvailabilityResponse": {
        "properties": {
          "branchCode": {
            "type": "string",
            "title": "Branchcode"
          },
          "branchName": {
            "type": "string",
            "title": "Branchname"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          }
        },
        "type": "object",
        "required": [
          "branchCode",
          "branchName",
          "available"
        ],
        "title": "BranchAvailabilityResponse",
        "description": "Whether one branch can supply a model for the whole period asked about."
      },
      "BranchListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/BranchResponse"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "BranchListResponse",
        "description": "The active branches, ordered by name."
      },
      "BranchResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "suburb": {
            "type": "string",
            "title": "Suburb"
          },
          "city": {
            "type": "string",
            "title": "City"
          },
          "phone": {
            "type": "string",
            "title": "Phone"
          },
          "opensAt": {
            "type": "string",
            "title": "Opensat"
          },
          "closesAt": {
            "type": "string",
            "title": "Closesat"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "suburb",
          "city",
          "phone",
          "opensAt",
          "closesAt"
        ],
        "title": "BranchResponse",
        "description": "One trading branch."
      },
      "CategoryListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CategoryResponse"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "CategoryListResponse",
        "description": "The active categories, each parent followed by its children."
      },
      "CategoryResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
